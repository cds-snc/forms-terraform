{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "allowJs": true,
    "rootDir": "src",
    "outDir": "build",
    "types": ["node"],
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*"]
}
